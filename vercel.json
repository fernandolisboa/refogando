{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run db:migrate && npm run build",
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "crons": [
    {
      "path": "/api/cron/dsar-sla",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/account-purge",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/rate-limit-cleanup",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/image-derivatives",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/cron/ai-models",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "30 11 * * *"
    }
  ]
}
